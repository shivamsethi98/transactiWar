# TransactiWar - Apache Rewrite Rules

# Disable directory listing
Options -Indexes

# Rewrite engine
RewriteEngine On

# Don't rewrite actual files/directories (CSS, JS, images)
RewriteCond %{REQUEST_URI} ^/assets/ [OR]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Route everything else through index.php
RewriteRule ^ index.php [L,QSA]

# Block direct access to core/ and templates/ directories
RewriteRule ^core/ - [F,L]
RewriteRule ^templates/ - [F,L]

# Block access to .htaccess itself
<Files ".htaccess">
    Require all denied
</Files>

# Block PHP execution in assets directory
<FilesMatch "^assets/.*\.php$">
    Require all denied
</FilesMatch>
