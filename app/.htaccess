# TransactiWar - Apache Rewrite Rules

# Disable directory listing
Options -Indexes

# Rewrite engine
RewriteEngine On

# Block direct access to core/ and templates/ directories FIRST
RewriteRule ^core/ - [F,L]
RewriteRule ^templates/ - [F,L]
RewriteRule ^pages/ - [F,L]

# Block PHP execution from the assets path
RewriteRule ^assets/.*\.php$ - [F,L,NC]

# Don't rewrite actual static assets (CSS, JS, images only)
RewriteCond %{REQUEST_URI} ^/assets/
RewriteRule ^ - [L]

# Route everything else through index.php
RewriteRule ^ index.php [L,QSA]

# Block access to .htaccess itself
<Files ".htaccess">
    Require all denied
</Files>
